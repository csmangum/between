# Signs the session cookie. Anyone who knows it can log in as either person.
# ./run.sh fills this in on first run; otherwise:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=Between

# Two people who share this space. Names are lowercase letters, digits, - or _.
# Give each person either a *_PASSWORD (12+ characters) or, better, a
# *_PASSWORD_HASH so the password itself is never stored on the host:
#   python -m app.passwords
USER1_NAME=chris
USER1_DISPLAY=Chris
USER1_PASSWORD=
# USER1_PASSWORD_HASH=pbkdf2_sha256$...

USER2_NAME=friend
USER2_DISPLAY=Friend
USER2_PASSWORD=
# USER2_PASSWORD_HASH=pbkdf2_sha256$...

# Set to true whenever the app is reached over HTTPS (any hosted deployment).
# Marks the cookie Secure and sends HSTS. Leave false only for plain-HTTP localhost.
HTTPS_ONLY=false

# Optional hardening
# ALLOWED_HOSTS=between.example.org        # refuse requests for other Host names
# SESSION_DAYS=7                            # how long a login lasts
# LOGIN_ATTEMPTS_PER_IP=5                   # failed logins per address per window
# LOGIN_ATTEMPTS_PER_NAME=20                # failed logins per account per window
# LOGIN_WINDOW_MINUTES=15
# MAX_REQUEST_KB=2048

# Optional: draft a reply from the readable record only.
# Note: everything you can read on a topic, including what the other person
# has opened to you, is sent to this endpoint when you ask for a draft.
# XAI_API_KEY=xai-...
# AGENT_API_KEY=
# AGENT_BASE_URL=https://api.x.ai/v1
# AGENT_MODEL=grok-4
