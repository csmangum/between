# run.sh fills SECRET_KEY in when it creates .env. Otherwise:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=Between

# Two people who share this space. Prefer a hash (python -m app.auth) over a plaintext password.
USER1_NAME=chris
USER1_DISPLAY=Chris
USER1_PASSWORD_HASH=
USER1_PASSWORD=change-me

USER2_NAME=friend
USER2_DISPLAY=Friend
USER2_PASSWORD_HASH=
USER2_PASSWORD=change-me

# Optional operator login. Leave both unset and the name admin does not exist.
# It can act as either person. It is not a third account in the room.
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# Set true only when a browser reaches the app over HTTPS (marks the cookie Secure, sends HSTS)
# HTTPS_ONLY=true

# Local development only: tolerates a missing SECRET_KEY by generating one per start.
# BETWEEN_DEV=1

# Session length: idle days before you are asked to sign in again, and the absolute cap.
# SESSION_IDLE_DAYS=7
# SESSION_MAX_DAYS=30

# Markdown mirrors under data/local and data/shared. Set false to keep the record in SQLite only.
# MARKDOWN_MIRROR=true

# Optional drafting help. Off until a key is set AND both people allow it from their desk.
# The readable record is sent to this provider when someone asks for a draft.
# XAI_API_KEY=xai-...
# AGENT_API_KEY=
# AGENT_BASE_URL=https://api.x.ai/v1
# AGENT_MODEL=grok-4
