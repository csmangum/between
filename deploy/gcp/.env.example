# Copy to deploy/gcp/.env on the VM, chmod 600 it, never commit it.
SITE_ADDRESS=between.example.com
ACME_EMAIL=you@example.com

# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=Between
HTTPS_ONLY=true

# Generate each hash on your own machine: python -m app.auth
USER1_NAME=chris
USER1_DISPLAY=Chris
USER1_PASSWORD_HASH=

USER2_NAME=karin
USER2_DISPLAY=Karin
USER2_PASSWORD_HASH=

# Optional operator login. Leave unset and the name admin does not exist.
# ADMIN_PASSWORD_HASH=

# Optional drafting help. Leave blank to keep it off. Even with a key, it only works
# once both people allow it from their desk; the readable record then goes to AGENT_BASE_URL.
XAI_API_KEY=
AGENT_API_KEY=
AGENT_BASE_URL=https://api.x.ai/v1
AGENT_MODEL=grok-4
